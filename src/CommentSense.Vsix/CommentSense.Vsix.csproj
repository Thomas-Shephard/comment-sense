<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>false</UseArtifactsOutput>

    <!-- VSIX Configuration -->
    <OutDir>bin\$(Configuration)\</OutDir>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <IsVsixProject>true</IsVsixProject>
    <VsixType>v3</VsixType>
    <TargetVsixContainerName>CommentSense.vsix</TargetVsixContainerName>
    <GenerateVsixContainer>true</GenerateVsixContainer>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <GenerateExtension>true</GenerateExtension>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <VsixPublisherId Condition="'$(VsixPublisherId)' == ''">$(Authors.Replace(' ', ''))</VsixPublisherId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Placeholder.cs" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommentSense.Analyzers\CommentSense.Analyzers.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\CommentSense.Core\CommentSense.Core.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(ArtifactsPath)\bin\CommentSense.Analyzers\$(Configuration)\CommentSense.Analyzers.dll">
      <Link>CommentSense.Analyzers.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(ArtifactsPath)\bin\CommentSense.Core\$(Configuration)\CommentSense.Core.dll">
      <Link>CommentSense.Core.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\Logo.png">
      <Link>Logo.png</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <Import Project="$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets" Condition="'$(PkgMicrosoft_VSSDK_BuildTools)' != ''" />

  <Target Name="GenerateMarketplaceMetadata" BeforeTargets="GetVsixSourceItems" DependsOnTargets="MinVer">
    <PropertyGroup>
      <IsPreview>false</IsPreview>
      <IsPreview Condition="'$(MinVerPreRelease)' != ''">true</IsPreview>
      <MarketplaceManifestContent>
{
    "$schema": "http://json.schemastore.org/vsix-publish",
    "categories": [ "coding", "analyzers" ],
    "identity": {
        "internalName": "CommentSense"
    },
    "overview": "overview.md",
    "priceCategory": "free",
    "publisher": "$(VsixPublisherId)",
    "private": false,
    "qna": true,
    "repo": "$(RepositoryUrl)",
    "preview": $(IsPreview.ToLower())
}
      </MarketplaceManifestContent>
    </PropertyGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)publish-manifest.json" Lines="$(MarketplaceManifestContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\README.md" DestinationFiles="$(IntermediateOutputPath)overview.md" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GenerateVsixManifest" BeforeTargets="BeforeBuild;GetVsixSourceItems" DependsOnTargets="MinVer">
    <PropertyGroup>
      <GeneratedVsixManifest>$(IntermediateOutputPath)extension.vsixmanifest</GeneratedVsixManifest>
      <IntermediateVsixManifest>$(GeneratedVsixManifest)</IntermediateVsixManifest>
      <VsixRevision Condition="'$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</VsixRevision>
      <VsixRevision Condition="'$(VsixRevision)' == ''">0</VsixRevision>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="source.extension.vsixmanifest" DestinationFiles="$(GeneratedVsixManifest)" />

    <XmlPoke XmlInputPath="$(GeneratedVsixManifest)"
             Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;"
             Query="/ns:PackageManifest/ns:Metadata/ns:Identity/@Version"
             Value="$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).$(VsixRevision)" />

    <XmlPoke XmlInputPath="$(GeneratedVsixManifest)"
             Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;"
             Query="/ns:PackageManifest/ns:Metadata/ns:Identity/@Publisher"
             Value="$(VsixPublisherId)" />
  </Target>

  <Target Name="CopyVsixToArtifacts" AfterTargets="CreateVsixContainer">
    <MakeDir Directories="$(ArtifactsPath)\vsix\" />
    <Copy SourceFiles="$(OutDir)$(TargetVsixContainerName)" DestinationFolder="$(ArtifactsPath)\vsix\" />
  </Target>
</Project>
